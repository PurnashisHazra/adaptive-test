# MongoDB connection URI (required) — same format as Mongoose/Node: mongodb://… or mongodb+srv://…
MONGODB_URI=mongodb://localhost:27017

# Database name (optional)
MONGODB_DB_NAME=adaptive_testing

# CORS — comma-separated origins for the React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Defaults
DEFAULT_TEST_QUESTION_COUNT=10
DEFAULT_TEST_TIME_LIMIT_SECONDS=1800

# OpenAI (optional) - used to generate new EXPERT questions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Cloudflare R2 (optional) — question image uploads from admin UI → POST /api/questions/upload-image
# S3 API endpoint from R2 dashboard (Account API Tokens / bucket details).
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for objects (R2 custom domain or public bucket URL), no trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
