# Nginx on the host (no Docker): TLS + static SPA + proxy to local FastAPI.
#
# 1. Replace YOUR_DOMAIN everywhere (including ssl_certificate paths).
# 2. Replace REPO_ROOT with the absolute path to this repository on the server
#    (must contain frontend/dist after `npm run build`).
# 3. Copy to e.g. /etc/nginx/sites-available/adaptest and symlink sites-enabled.
# 4. API must listen on 127.0.0.1:8000 (see deploy/SSL.md).

upstream adaptest_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root REPO_ROOT/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://adaptest_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
