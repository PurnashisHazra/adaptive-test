# Full stack on one DigitalOcean droplet: SPA + /api → uvicorn on 127.0.0.1:8000
#
# 1. Replace REPO_ROOT (e.g. /var/www/adaptive-testing-platform).
# 2. Build frontend: cd REPO_ROOT/frontend && npm ci && npm run build
# 3. Copy to /etc/nginx/sites-available/adaptest.in
# 4. ln -s ... sites-enabled/ && certbot --nginx -d adaptest.in -d www.adaptest.in
# 5. systemctl: adaptive-api.service (see deploy/DROPLET.md)

upstream adaptest_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name adaptest.in www.adaptest.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name adaptest.in www.adaptest.in;

    ssl_certificate     /etc/letsencrypt/live/adaptest.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/adaptest.in/privkey.pem;

    root REPO_ROOT/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://adaptest_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
